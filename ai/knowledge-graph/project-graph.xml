  <flows>
    <flow id="user_onboarding">
      <name>User onboarding and preferences</name>
      <entrypoints>/start, /settings, one allowlisted E2E group chat</entrypoints>
      <summary>Registers user, picks language, stores timezone and language, and can run in one allowlisted E2E chat for black-box verification.</summary>
    </flow>
    <flow id="subscription_management">
      <name>Subscription management</name>
      <entrypoints>/subscriptions, inline callbacks</entrypoints>
      <summary>Create, rename, configure, enable, disable, and delete named subscriptions.</summary>
    </flow>
    <flow id="channel_membership">
      <name>Channel membership management</name>
      <entrypoints>subscription add/remove channel actions</entrypoints>
      <summary>Validates public usernames, adds shared channels, removes channel membership per subscription.</summary>
    </flow>
    <flow id="scraping_job">
      <name>Scheduled scraping</name>
      <entrypoints>APScheduler scraping job</entrypoints>
      <summary>Iterates active channels, fetches pages, parses posts, stores new posts, marks channel state.</summary>
    </flow>
    <flow id="digest_delivery_flow">
      <name>Scheduled digest delivery</name>
      <entrypoints>APScheduler digest job</entrypoints>
      <summary>Selects due subscriptions, finds unprocessed posts, renders digests, sends Telegram messages, stores delivered and skipped processing state.</summary>
    </flow>
    <flow id="summary_generation">
      <name>LLM summary generation</name>
      <entrypoints>DigestService summary branch</entrypoints>
      <summary>Uses an hourly refreshed OpenRouter free-model pool for empty-post pre-skip plus structured JSON schema filter-then-synthesize batch summaries, may use mem0 memories in the filter stage, renders source-linked topic bullets, retries the next model on invalid JSON, and falls back safely to 200-character mode on failure or empty model output.</summary>
    </flow>
    <flow id="natural_language_control" status="active">
      <name>Natural-language bot control</name>
      <entrypoints>free-text messages outside FSM states</entrypoints>
      <summary>Uses an hourly refreshed OpenRouter free-model assistant pool with cached tool-support probes and internal tools to inspect and mutate bot product state, shows Telegram typing feedback while the turn runs, then emits deterministic localized Telegram-safe HTML confirmations with bold subscription names.</summary>
    </flow>
    <flow id="assistant_memory">
      <name>Assistant semantic memory</name>
      <entrypoints>before and after assistant turns</entrypoints>
      <summary>Retrieves and updates mem0 semantic memories independently from the assistant; memory mutation tools are not exposed to the model. Compose mounts ./.data to /app/.data so local Qdrant/history state survives app recreates. The app creates one shared process-local memory service for scheduler digest filtering and bot assistant turns.</summary>
    </flow>
  </flows>

  <invariants>
    <invariant id="inv_delivery_dedup">
      <name>No duplicate delivery per subscription/post</name>
      <summary>The same post must not be delivered or skipped twice for the same subscription; any DigestDelivery status removes it from pending selection.</summary>
    </invariant>
    <invariant id="inv_post_dedup">
      <name>No duplicate persisted post per channel/post_id</name>
      <summary>Re-scraping must be idempotent for existing Telegram posts.</summary>
    </invariant>
    <invariant id="inv_subscription_baseline">
      <name>No historical posts before subscribed_at</name>
      <summary>Posts published before a subscription added the channel must not appear in future digests for that subscription.</summary>
    </invariant>
    <invariant id="inv_due_logic">
      <name>Timezone and frequency control due delivery</name>
      <summary>Daily and hourly digests must respect user timezone and subscription frequency.</summary>
    </invariant>
    <invariant id="inv_summary_fallback">
      <name>Summary failures must not block delivery</name>
      <summary>If summary model refresh, structured filter/synthesis JSON, model calls, empty model output, or model health selection fail, the bot must retry usable models when possible and still send a short digest for non-empty posts using normal digest grouping; empty extracted posts are skipped before LLM calls.</summary>
    </invariant>
    <invariant id="inv_reply_current_content">
      <name>Reply context never replaces current post body</name>
      <summary>Scraped reply posts must store and summarize the current post text, excluding replied-to/quoted Telegram context from digest rendering and LLM input.</summary>
    </invariant>
    <invariant id="inv_safe_html">
      <name>Visible bot output must remain Telegram-safe HTML</name>
      <summary>Rendered digest and assistant output must keep allowed tags and valid links without raw Markdown or broken Telegram formatting; assistant mutation confirmations must localize RU/EN text and bold subscription names with escaped Telegram HTML.</summary>
    </invariant>
    <invariant id="inv_channel_scope">
      <name>Channel membership is per subscription, not global per user</name>
      <summary>Each named subscription has its own channel list and delivery scope.</summary>
    </invariant>
    <invariant id="inv_cron_min_interval">
      <name>Notification cron interval is bounded</name>
      <summary>Assistant-provided notification cron expressions must not fire more often than every 15 minutes; valid interval schedules such as every 3 hours must render in tools and bot screens without crashing.</summary>
    </invariant>
    <invariant id="inv_tool_authorization">
      <name>Assistant mutations go through authorized tools</name>
      <summary>The assistant can mutate product state only through user-scoped product tools, never raw repositories or database sessions; assistant model selection must prefer models with confirmed tool support.</summary>
    </invariant>
    <invariant id="inv_memory_not_tool_managed">
      <name>Assistant memory is not tool-managed by the model</name>
      <summary>mem0 memory retrieval/extraction is performed by an independent layer; the assistant does not receive save/delete memory tools.</summary>
    </invariant>
    <invariant id="inv_memory_local_persistence">
      <name>Local mem0 state persists outside the container</name>
      <summary>When local mem0 storage is enabled, Qdrant and history files must stay under the host-mounted .data path, be excluded from git and Docker build context, and be accessed by only one process-local memory service to avoid Qdrant local lock conflicts.</summary>
    </invariant>
  </invariants>

