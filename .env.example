# Database
DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://bot:change-me@db:5432/telegram_bot
RUN_MIGRATIONS=1

# Telegram Bot
BOT_TOKEN=
# Keep the default in real deployments; stage-6 Compose overrides it for the isolated fake Bot API.
BOT_API_BASE_URL=https://api.telegram.org
BOT_ENABLED=1
BOT_POLLING=1
BOT_DEFAULT_TIMEZONE=UTC

# Real Telegram E2E
E2E_TELEGRAM_TOKEN=
E2E_CHAT_ID=

# LLM / OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_TIMEOUT_SECONDS=30

# Natural-language assistant
ASSISTANT_ENABLED=1
ASSISTANT_HISTORY_LIMIT=30
ASSISTANT_MAX_TOOL_ROUNDS=5

# Admin dashboard at https://csd.ai-research.arha.digital
# Generate the password hash: python -m src.admin.passwords 'choose-a-password'
ADMIN_ENABLED=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SECURE_COOKIES=1

# mem0 memory layer. Uses OPENROUTER_API_KEY by default.
MEMORY_ENABLED=1
MEMORY_COLLECTION_NAME=telegram_parser_bot_memories
MEMORY_QDRANT_PATH=.data/mem0/qdrant
MEMORY_HISTORY_DB_PATH=.data/mem0/history.db
MEMORY_EMBEDDER_MODEL=qwen/qwen3-embedding-8b
MEMORY_EMBEDDING_DIMS=4096

# BL-22 Kafka stages. `docker compose --profile bl22` enables Kafka inside the
# role containers, but the app operations probe requires KAFKA_ENABLED=1 here.
# Keep 0 when the profile is off; shadow mode uses 1 with reliable delivery 0.
KAFKA_ENABLED=0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_CLIENT_ID_PREFIX=telegram-parser-bot
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_STARTUP_TIMEOUT_SECONDS=60
KAFKA_TOPIC_PARTITIONS=1
KAFKA_TOPIC_REPLICATION_FACTOR=1
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_DLQ_RETENTION_MS=2592000000
KAFKA_TOPIC_RETENTION_BYTES=536870912
KAFKA_DLQ_RETENTION_BYTES=268435456
KAFKA_MAX_EVENT_BYTES=65536
KAFKA_OUTBOX_LEASE_SECONDS=30
KAFKA_OUTBOX_PUBLISH_TIMEOUT_SECONDS=10
KAFKA_OUTBOX_POLL_INTERVAL_SECONDS=1
KAFKA_OUTBOX_BATCH_SIZE=100
KAFKA_OUTBOX_BACKOFF_BASE_SECONDS=1
KAFKA_OUTBOX_BACKOFF_CAP_SECONDS=60
# Reliable delivery is separately fail-closed. Allowlisted testing requires an
# explicit ID list and memory-disabled rendering.
RELIABLE_DIGEST_ENABLED=0
RELIABLE_DIGEST_SUBSCRIPTION_IDS=[]
RELIABLE_DIGEST_ALL_SUBSCRIPTIONS=0
RELIABLE_DIGEST_POLL_INTERVAL_SECONDS=1
RELIABLE_DIGEST_CONSUMER_POLL_TIMEOUT_MS=1000
RELIABLE_DIGEST_INBOX_LEASE_SECONDS=900
RELIABLE_DIGEST_RENDER_LEASE_SECONDS=900
RELIABLE_DIGEST_RENDER_MAX_ATTEMPTS=5
RELIABLE_DIGEST_DELIVERY_LEASE_SECONDS=60
RELIABLE_DIGEST_DELIVERY_SEND_TIMEOUT_SECONDS=30
RELIABLE_DIGEST_DELIVERY_MAX_ATTEMPTS=10
RELIABLE_DIGEST_DELIVERY_BACKOFF_BASE_SECONDS=2
RELIABLE_DIGEST_DELIVERY_BACKOFF_CAP_SECONDS=900
RELIABLE_DIGEST_RENDER_MEMORY_ENABLED=0
# Optional explicit worker-only OpenRouter injection. In Compose, BOT_TOKEN is
# passed only to telegram-delivery-worker among the BL-22 roles.
RELIABLE_DIGEST_OPENROUTER_API_KEY=
RELIABLE_DIGEST_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RELIABLE_DIGEST_LLM_TIMEOUT_SECONDS=30
# Do not change this value while an initialized kafka_data volume exists.
KAFKA_KRAFT_CLUSTER_ID=q1Sh-9_ISia_zwGINzRvyQ
APP_IMAGE_TAG=bl22-stage4

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
